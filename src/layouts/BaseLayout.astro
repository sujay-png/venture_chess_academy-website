---
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/animations.css';

import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { getSeoForPath, defaultSeo } from '../data/seo';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  forceTitle?: string;
  forceDescription?: string;
}

const pathname = Astro.url.pathname;
const pageSeo = getSeoForPath(pathname);

const title = Astro.props.forceTitle || pageSeo?.title || Astro.props.title || defaultSeo.title;
const description = Astro.props.forceDescription || pageSeo?.description || Astro.props.description || defaultSeo.description;
const keywords = pageSeo?.keywords || Astro.props.keywords || defaultSeo.keywords;
const ogImage = pageSeo?.ogImage || Astro.props.ogImage || defaultSeo.ogImage;
const ogType = pageSeo?.ogType || Astro.props.ogType || defaultSeo.ogType;
const canonicalUrl = pageSeo?.canonicalUrl || Astro.props.canonicalUrl || new URL(pathname, Astro.site || 'https://venturechessacademy.com').href;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Venture Chess Academy",
  "alternateName": "VCA",
  "url": "https://venturechessacademy.com",
  "logo": "https://venturechessacademy.com/wp-content/uploads/2025/04/Venture-Chess-Academy.png",
  "image": ogImage,
  "description": description,
  "telephone": "+919567027370",
  "email": "contact@venturechessacademy.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "HEGDE Arcade, Main Road",
    "addressLocality": "Puttur",
    "addressRegion": "Karnataka",
    "postalCode": "574201",
    "addressCountry": "IN"
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo/cropped-Venture-Chess-Academy-32x32.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Venture Chess Academy" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- JSON-LD Structured Data for Google Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    
    <script>
      // Scroll reveal logic
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.addEventListener('DOMContentLoaded', () => {
        const revealElements = document.querySelectorAll('.reveal-fade-up, .reveal-clip-path, .image-reveal-wrapper');
        revealElements.forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>
