---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MagneticButton from '../../components/ui/MagneticButton.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

// Fetch posts from WordPress REST API
const response = await fetch('https://venturechessacademy.com/wp-json/wp/v2/posts?_embed&per_page=100');
let posts = [];

if (response.ok) {
  posts = await response.json();
} else {
  console.error("Failed to fetch posts from WordPress API");
}

function formatDate(dateString: string) {
  const date = new Date(dateString);
  const day = String(date.getDate()).padStart(2, '0');
  const month = date.toLocaleString('en-US', { month: 'short' });
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
}
---

<BaseLayout title="Chess Tactics | Learn Chess | Chess for Beginners | Chess Tips" description="Explore expert chess blogs with tips, strategies, openings, tactics, puzzles, and guides to improve your chess skills at every level.">
  <PageHeader title="Chess Insights">
    <p class="page-description reveal-fade-up" style="transition-delay: 0.1s;">
      Explore expert insights, practical guides and the latest developments in chess mastery,
      <br>opening strategies, and tournament preparation.
    </p>
  </PageHeader>

  <section class="section blog-content">
    <div class="container">
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post: any, index: number) => {
            const delay = 0.1 * (index % 3);
            const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '/placeholder-blog.jpg';
            const category = post._embedded?.['wp:term']?.[0]?.[0]?.name || 'Insights';
            const excerpt = post.excerpt.rendered.replace(/<[^>]+>/g, '').slice(0, 150) + '...';

            return (
              <a href={`/blog/${post.slug}`} class="blog-card reveal-fade-up" style={`transition-delay: ${delay}s;`}>
                <div class="blog-card-image-wrap">
                  {featuredImage && (
                    <img src={featuredImage} alt={post.title.rendered.replace(/<[^>]+>/g, '')} class="blog-card-image" loading="lazy" />
                  )}
                </div>
                <div class="blog-card-content">
                  <div class="blog-meta">
                    <span class="meta-date">{formatDate(post.date)}</span>
                    <span class="meta-separator">&bull;</span>
                    <span class="meta-category">{category}</span>
                  </div>
                  <h3 class="blog-title" set:html={post.title.rendered} />
                  <p class="blog-excerpt" set:html={excerpt} />
                  
                  <div class="blog-read-more">
                    <span class="read-text">Read Article</span>
                    <span class="read-icon">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="blog-placeholder reveal-fade-up text-center">
          <h2 class="text-h2 text-primary mb-4">Temporarily Unavailable</h2>
          <p class="mb-8" style="max-width: 600px; margin-left: auto; margin-right: auto;">We are unable to load the latest articles at the moment. Please try again later or visit our live blog directly.</p>
          <MagneticButton href="https://venturechessacademy.com/blog/" text="Visit Live Blog" variant="primary" />
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-description {
      color: #e9ecf1;
    font-size: 1.125rem;
    max-width: 800px;
    margin: 1.5rem auto 0;
    line-height: 1.6;
    text-align: center;
  }

  .blog-content {
    /* Uses standard .section vertical padding */
  }

  /* Grid layout matching image */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-md);
    
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff; /* White background */
    border-radius: var(--radius-xl); /* Rounded corners */
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    /* Subtle border and shadow to match reference */
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blog-card-image-wrap {
    width: 100%;
    height: 240px; /* Fixed height for image area */
    overflow: hidden;
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.75rem;
    font-weight: 700;
    color: #e85d04; /* Orange color matching image */
    margin-bottom: var(--space-sm);
    font-family: var(--font-body);
  }

  .meta-separator {
    color: #cbd5e1;
    font-size: 0.8rem;
  }

  .blog-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Usually titles are limited to 2-3 lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }

  .blog-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #64748b;
    margin-bottom: var(--space-md);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-read-more {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: auto;
  }

  .read-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
  }

  .read-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #e2e8f0;
    color: #0f172a;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .blog-card:hover .read-icon {
    background-color: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }

  .blog-placeholder {
    background-color: var(--color-surface);
    border-radius: var(--radius-2xl);
    padding: 6rem 2rem;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .page-description br {
      display: none;
    }
  }
</style>
