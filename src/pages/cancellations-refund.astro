---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

let pageContent = '';
let pageTitle = 'Cancellation & Refund Policy';

try {
  const response = await fetch('https://venturechessacademy.com/wp-json/wp/v2/pages?slug=cancellations-refund');
  if (response.ok) {
    const pages = await response.json();
    if (pages && pages.length > 0) {
      pageContent = pages[0].content.rendered;
      pageTitle = pages[0].title.rendered;
    } else {
      pageContent = '<p>Cancellation & refund policy content is not available.</p>';
    }
  }
} catch (e) {
  console.error("Failed to fetch cancellation & refund policy", e);
  pageContent = '<p>Failed to load policy. Please try again later.</p>';
}
---

<BaseLayout title="Cancellations &amp;refund - venture" description="">
  <article class="legal-page-wrapper">
    
    <PageHeader title={pageTitle} />

    <!-- Content Section -->
    <div class="container section legal-content-container">
      <div class="legal-prose-content mx-auto" set:html={pageContent} />
    </div>

  </article>
</BaseLayout>

<style is:global>
  .legal-page-wrapper {
    background-color: #f8fafc;
    
  }

  .legal-content-container {
     
    position: relative;
    z-index: 20;
  }

  .legal-prose-content {
    background-color: #ffffff;
    padding: 3rem 4rem;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.15rem;
    line-height: 1.8;
    color: #334155;
    border: 1px solid #f1f5f9;
  }

  /* Hide duplicate titles from WP content */
  .legal-prose-content h1, 
  .legal-prose-content h2:first-child {
    display: none !important; 
  }

  .legal-prose-content h2,
  .legal-prose-content h3,
  .legal-prose-content h4 {
    color: #0f172a;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-weight: 700;
  }
  
  .legal-prose-content h2 { 
    font-size: 1.8rem; 
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.75rem;
  }
  
  .legal-prose-content h3 { 
    font-size: 1.4rem; 
    color: var(--color-primary, #592218); 
  }

  .legal-prose-content p {
    margin-bottom: var(--space-md);
  }

  .legal-prose-content ul,
  .legal-prose-content ol {
    margin-bottom: var(--space-md);
    padding-left: 1.5rem;
    background-color: #f8fafc;
    padding: 1.5rem 1.5rem 1.5rem 3rem;
    border-radius: 12px;
  }

  .legal-prose-content li {
    margin-bottom: 0.75rem;
  }
  
  .legal-prose-content li::marker {
    color: var(--color-primary, #592218);
    font-weight: 700;
  }

  .legal-prose-content a {
    color: var(--color-primary, #592218);
    text-decoration: none;
    border-bottom: 2px solid var(--color-secondary, #facc15);
    transition: background-color 0.3s ease;
  }
  
  .legal-prose-content a:hover {
    background-color: #fefce8;
  }

  @media (max-width: 768px) {
    .legal-hero-banner {
      
      
    }
    .legal-prose-content {
      padding: 2rem 1.5rem;
      border-radius: 16px;
    }
    .legal-content-container {
      
    }
  }
</style>
