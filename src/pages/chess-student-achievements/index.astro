---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { achievements } from '../../data/achievements';
import CTA from '../../components/home/CTA.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
---

<BaseLayout title="Chess student achievements | Venture chess academy" description="Celebrate the inspiring chess student achievements showcasing tournament wins, awards, and remarkable growth in chess skills.">
  <PageHeader title="Our Stars" subtitle="HALL OF FAME" />

  <section class="section achievements-content">
    <div class="container">
      <div class="achievements-grid">
        {achievements.map((result, index) => (
          <div class="result-card hover-lift reveal-fade-up" style={`transition-delay: ${(index % 3) * 0.1}s;`}>
            <div class="result-image" data-cursor-text="VIEW">
              <img src={result.image} alt={result.name} loading="lazy" />
            </div>
            <div class="result-content">
              <h3 class="student-name">{result.name}</h3>
              {result.achievement && (
                <p class="student-achievement">{result.achievement}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .achievements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .achievements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .achievements-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .result-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .result-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .result-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .result-card:hover .result-image img {
    transform: scale(1.05);
  }

  .student-name {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .student-achievement {
    color: var(--color-text-light);
    font-size: 1rem;
    margin: 0;
  }
</style>
