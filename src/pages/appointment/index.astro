---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
---

<BaseLayout title="Page not found - venture" description="">
  <PageHeader title="Book Online Chess Classes" subtitle="FREE TRIAL" />

  <section class="section appointment-content">
    <div class="container">
      <div class="booking-wrapper reveal-fade-up">
        <!-- Placeholder for Booking Embed (e.g. Calendly) -->
        <div class="booking-placeholder">
          <h3 class="text-h3 text-primary mb-4">Schedule Your Free Trial</h3>
          <p class="mb-4 text-center">Please select a time that works best for you to attend the demo session.</p>
          
          <div class="mock-calendar">
            <div class="mock-section-header">
              <span class="mock-month">September 2026</span>
              <div class="mock-arrows">
                <span>&lt;</span>
                <span>&gt;</span>
              </div>
            </div>
            <div class="mock-calendar-grid">
              <!-- Mock days -->
              {Array.from({length: 30}).map((_, i) => (
                <div class={`mock-day ${i === 15 ? 'is-selected' : ''}`}>{i + 1}</div>
              ))}
            </div>
            
            <a href="mailto:venturechessacademy@gmail.com" class="booking-cta mt-8">Contact Us to Book</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .text-primary {
    color: var(--color-primary);
  }

  .mb-4 {
    margin-bottom: var(--space-md);
  }

  .mt-8 {
    margin-top: 2rem;
  }

  .booking-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-2xl);
    padding: var(--space-md);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .booking-wrapper {
      padding: 5rem;
    }
  }

  .booking-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Mock Calendar Styles just for aesthetics until real embed is provided */
  .mock-calendar {
    width: 100%;
    max-width: 400px;
    background-color: var(--color-bg);
    border-radius: var(--radius-xl);
    padding: var(--space-md);
    margin-top: 2rem;
    border: 1px solid var(--color-border);
  }

  .mock-calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .mock-arrows span {
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-primary);
  }

  .mock-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--space-xs);
  }

  .mock-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .mock-day:hover {
    background-color: rgba(30, 58, 138, 0.1);
  }

  .mock-day.is-selected {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .booking-cta {
    display: block;
    width: 100%;
    padding: 1rem;
    background-color: var(--color-secondary);
    color: var(--color-primary);
    text-align: center;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: transform 0.3s var(--ease-out);
  }

  .booking-cta:hover {
    transform: scale(1.05);
  }
</style>
