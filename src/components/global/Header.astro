---
import MagneticButton from "../ui/MagneticButton.astro";

const pathname = Astro.url.pathname;
const normalizedPathName =
  pathname.length > 1 && pathname.endsWith("/")
    ? pathname.slice(0, -1)
    : pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Results", href: "/chess-student-achievements/" },
  { label: "Courses", href: "/chess-academy-karnataka-india/" },
  { label: "Blog", href: "/blog/" },
  { label: "VCA Games", href: "/vca-free-mini-games/" },
  { label: "Contact", href: "/contact-us/" },
];

const checkActive = (href: string) => {
  const normalizedHref =
    href.length > 1 && href.endsWith("/") ? href.slice(0, -1) : href;
  if (normalizedHref === "/") {
    return normalizedPathName === "/";
  }
  return normalizedPathName.startsWith(normalizedHref);
};
---

<header class="header reveal-fade-up">
  <div class="header-container">
    <a href="/" class="logo-link">
      <img
        src="https://venturechessacademy.com/wp-content/uploads/2025/04/Venture-Chess-Academy.png"
        alt="Venture Chess Academy"
        class="logo-image"
      />
    </a>

    <nav class="desktop-nav">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`nav-link ${checkActive(item.href) ? "is-active" : ""}`}
              >
                <span class="nav-text">
                  <span class="nav-text-default">{item.label}</span>
                  <span class="nav-text-hover" aria-hidden="true">{item.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <MagneticButton
        href="https://classroom.venturechessacademy.com/login?_gl=1*g9sg7d*_ga*MTAwMjI4ODMyNy4xNzY5NDk1OTE0*_ga_1CJMJETPZP*czE3ODg4MzYxMDIkbzk1JGcxJHQxNzg4ODM2MTgyJGo2MCRsMCRoMA.."
        text="My Classroom &rarr;"
        variant="primary"
        className="header-cta classroom-btn-color"
      />
      <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div class="mobile-overlay" aria-hidden="true"></div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="mobile-drawer-header">
      <img
        src="https://venturechessacademy.com/wp-content/uploads/2025/04/Venture-Chess-Academy.png"
        alt="Venture Chess Academy"
        class="drawer-logo"
      />
      <button class="drawer-close" aria-label="Close menu">
        <span class="close-line"></span>
        <span class="close-line"></span>
      </button>
    </div>
    
    <div class="mobile-drawer-content">
      <ul class="mobile-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`mobile-nav-link ${checkActive(item.href) ? "is-active" : ""}`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mobile-drawer-footer">
      <a
        href="https://classroom.venturechessacademy.com/login?_gl=1*g9sg7d*_ga*MTAwMjI4ODMyNy4xNzY5NDk1OTE0*_ga_1CJMJETPZP*czE3ODg4MzYxMDIkbzk1JGcxJHQxNzg4ODM2MTgyJGo2MCRsMCRoMA.."
        class="drawer-cta-btn"
      >
        My Classroom &rarr;
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 1rem;
    left: 0;
    width: 100%;
    z-index: 100;
    pointer-events: none;
    transition: transform 0.3s var(--ease-out);
  }

  .header.is-scrolled {
    transform: translateY(-0.5rem);
  }

  .header-container {
    pointer-events: auto;
    max-width: 1200px;
    width: 95%;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    height: 80px;
    background-color: var(--color-nav-bg);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.03);
    transition: all 0.3s var(--ease-out);
  }

  .header.is-scrolled .header-container {
    background-color: rgba(253, 240, 224, 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .logo-link {
    display: flex;
    align-items: center;
    width: auto;
    position: relative;
    z-index: 101;
    flex-shrink: 0;
  }

  .logo-image {
    height: 48px;
    width: auto;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) {
    .logo-link:hover .logo-image,
    .logo-link:focus-visible .logo-image {
      transform: rotate(12deg) scale(1.08);
    }
  }

  .logo-link:focus-visible .logo-image {
    transform: rotate(12deg) scale(1.08);
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-container {
      height: 68px;
    }
    .desktop-nav {
      display: block;
      padding: 0 8px;
    }
    .logo-image {
      height: 50px;
    }
  }

  .nav-list {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: var(--color-text-light);
    position: relative;
    height: 36px;
    padding: 0 14px;
    border-radius: 8px;
    transition: all 0.3s var(--ease-out);
    z-index: 1;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-text {
    display: inline-grid;
    grid-template-areas: "stack";
    align-items: center;
    justify-items: center;
    overflow: hidden;
  }

  .nav-text-default,
  .nav-text-hover {
    grid-area: stack;
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }

  .nav-text-default {
    transform: translateY(0);
    opacity: 1;
  }

  .nav-text-hover {
    transform: translateY(100%);
    opacity: 0;
    color: var(--color-nav-active-text);
    font-weight: 600;
  }

  @media (hover: hover) {
    .nav-link:hover .nav-text-default,
    .nav-link:focus-visible .nav-text-default {
      transform: translateY(-100%);
      opacity: 0;
    }

    .nav-link:hover .nav-text-hover,
    .nav-link:focus-visible .nav-text-hover {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Sliding Hover Indicator */
  .nav-list::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    height: 70%;
    transform: translateY(-50%) translateX(var(--highlight-left, 0px));
    border-radius: 8px;
    background-color: var(--color-nav-pill-hover);
    pointer-events: none;
    z-index: 0;
    width: var(--highlight-width, 0px);
    opacity: var(--highlight-opacity, 0);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-nav-active-text);
  }

  .nav-link.is-active {
    color: var(--color-nav-active-text);
    font-weight: 600;
    background-color: var(--color-nav-pill);
  }

  .nav-link.is-active .nav-text-default {
    transform: translateY(-100%);
    opacity: 0;
  }

  .nav-link.is-active .nav-text-hover {
    transform: translateY(0);
    opacity: 1;
  }

  /* My Classroom CTA Animations & Colors */
  :global(.classroom-btn-color) {
    color: var(--color-primary) !important;
  }
  :global(.classroom-btn-color .btn-bg) {
    background-color: #f2b77a !important; /* Soft peach/orange */
  }

  :global(.header-cta .btn-text) {
    display: inline-grid !important;
    grid-template-areas: "stack" !important;
    align-items: center !important;
    justify-items: center !important;
    overflow: hidden !important;
  }

  :global(.header-cta-default),
  :global(.header-cta-hover),
  :global(.header-cta-launching) {
    grid-area: stack !important;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.35s ease !important;
    white-space: nowrap !important;
  }

  :global(.header-cta-default) {
    transform: translateY(0) !important;
    opacity: 1 !important;
    text-transform: uppercase !important;
  }

  :global(.header-cta-hover) {
    transform: translateY(120%) !important;
    opacity: 0 !important;
    text-transform: none !important;
  }

  :global(.header-cta-launching) {
    transform: translateY(120%) !important;
    opacity: 0 !important;
    text-transform: none !important;
  }

  @media (hover: hover) {
    :global(.header-cta:hover:not(.is-launching) .header-cta-default),
    :global(.header-cta:focus-visible:not(.is-launching) .header-cta-default) {
      transform: translateY(-120%) !important;
      opacity: 0 !important;
    }

    :global(.header-cta:hover:not(.is-launching) .header-cta-hover),
    :global(.header-cta:focus-visible:not(.is-launching) .header-cta-hover) {
      transform: translateY(0) !important;
      opacity: 1 !important;
    }
  }

  /* Launching state */
  :global(.header-cta.is-launching .header-cta-default),
  :global(.header-cta.is-launching .header-cta-hover) {
    transform: translateY(-120%) !important;
    opacity: 0 !important;
  }

  :global(.header-cta.is-launching .header-cta-launching) {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.header-cta-default),
    :global(.header-cta-hover),
    :global(.header-cta-launching) {
      transition: none !important;
    }

    .logo-image {
      transition: none !important;
    }

    .logo-link:hover .logo-image,
    .logo-link:focus-visible .logo-image {
      transform: none !important;
    }
  }

  /* Make header CTA button responsive */
  :global(.header-cta) {
    padding: 0.6rem 1.2rem !important;
    font-size: 0.85rem !important;
    border-radius: 8px !important;
  }

  :global(.header-cta .btn-bg) {
    border-radius: 8px !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    position: relative;
    z-index: 101;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    :global(.header-cta) {
      padding: 1.2rem 3rem !important;
      font-size: 1.1rem !important;
    }

    .header-actions {
      gap: var(--space-md);
    }
  }

  /* Hide header CTA on mobile */
  :global(.header-cta) {
    display: none !important;
  }
  @media (min-width: 1024px) {
    :global(.header-cta) {
      display: inline-flex !important;
      height: 44px !important;
      min-height: 44px !important;
      padding: 0 24px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      letter-spacing: 0.05em !important;
      text-transform: uppercase !important;
      width: auto !important;
    }
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: #592218; /* Dark brown */
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
    border-radius: 2px;
  }

  .mobile-menu-toggle.is-active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-menu-toggle.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-toggle.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Drawer Overlay */
  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-overlay.is-active {
    opacity: 1;
    pointer-events: all;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 400px; /* Tablet */
    height: 100vh;
    background-color: var(--color-bg);
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
    visibility: hidden;
    pointer-events: auto; /* Allow clicking links inside */
  }

  .mobile-drawer.is-active {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .drawer-logo {
    height: 40px;
    width: auto;
  }

  .drawer-close {
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    color: #592218;
    cursor: pointer;
    position: relative;
  }

  .drawer-close:focus-visible {
    outline: 2px solid #592218;
    border-radius: 4px;
  }

  .drawer-close .close-line {
    width: 24px;
    height: 2px;
    background-color: currentColor;
    position: absolute;
    border-radius: 2px;
  }
  
  .drawer-close .close-line:first-child {
    transform: rotate(45deg);
  }
  .drawer-close .close-line:last-child {
    transform: rotate(-45deg);
  }

  .mobile-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-family: var(--font-body);
    font-size: 1.125rem; /* 18px */
    font-weight: 500;
    color: var(--color-text-light);
    text-decoration: none;
    padding: 0 1rem;
    border-radius: 8px;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  .mobile-nav-link:focus-visible {
    outline: 2px solid #592218;
    outline-offset: -2px;
  }

  .mobile-nav-link.is-active {
    color: var(--color-nav-active-text);
    background-color: var(--color-nav-pill);
    font-weight: 600;
  }

  .mobile-drawer-footer {
    padding: 1.5rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }

  .drawer-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    background-color: #f2b77a; /* peach */
    color: #592218; /* dark brown */
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    border-radius: 8px; /* Rounded rectangle instead of pill */
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: transform 0.1s ease;
  }
  
  .drawer-cta-btn:active {
    transform: scale(0.98);
  }
  
  .drawer-cta-btn:focus-visible {
    outline: 2px solid #592218;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer, .mobile-overlay, .hamburger-line {
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Scroll effect
    const header = document.querySelector(".header");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        header?.classList.add("is-scrolled");
      } else {
        header?.classList.remove("is-scrolled");
      }
    });

    // Mobile Menu Toggle
    const menuToggle = document.querySelector(".mobile-menu-toggle");
    const drawerClose = document.querySelector(".drawer-close");
    const mobileDrawer = document.querySelector(".mobile-drawer") as HTMLElement | null;
    const mobileOverlay = document.querySelector(".mobile-overlay");
    
    let isMenuOpen = false;

    const openMenu = () => {
      isMenuOpen = true;
      menuToggle?.classList.add("is-active");
      menuToggle?.setAttribute("aria-expanded", "true");
      mobileDrawer?.classList.add("is-active");
      mobileOverlay?.classList.add("is-active");
      document.body.style.overflow = "hidden";
      setTimeout(() => (document.querySelector(".drawer-close") as HTMLElement)?.focus(), 100);
    };

    const closeMenu = () => {
      isMenuOpen = false;
      menuToggle?.classList.remove("is-active");
      menuToggle?.setAttribute("aria-expanded", "false");
      mobileDrawer?.classList.remove("is-active");
      mobileOverlay?.classList.remove("is-active");
      document.body.style.overflow = "";
      (menuToggle as HTMLElement)?.focus();
    };

    menuToggle?.addEventListener("click", () => isMenuOpen ? closeMenu() : openMenu());
    drawerClose?.addEventListener("click", closeMenu);
    mobileOverlay?.addEventListener("click", closeMenu);

    // Close on link click
    document.querySelectorAll(".mobile-nav-link").forEach(link => {
      link.addEventListener("click", closeMenu);
    });

    // Close on escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        closeMenu();
      }
    });

    // Focus trapping
    mobileDrawer?.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Tab") {
        const focusable = Array.from(document.querySelectorAll(".mobile-drawer .drawer-close, .mobile-drawer .mobile-nav-link, .mobile-drawer .drawer-cta-btn")) as HTMLElement[];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    });

    // Close on resize above 1024
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024 && isMenuOpen) {
        closeMenu();
      }
    });

    // 1) Sliding Hover Indicator
    const navList = document.querySelector('.nav-list') as HTMLElement | null;
    const navLinks = document.querySelectorAll('.nav-link');
    let activeLink: HTMLElement | null = null;

    if (navList) {
      const updateIndicator = (el: HTMLElement) => {
        activeLink = el;
        navList.style.setProperty('--highlight-left', `${el.offsetLeft}px`);
        navList.style.setProperty('--highlight-width', `${el.offsetWidth}px`);
        navList.style.setProperty('--highlight-opacity', '1');
      };

      navLinks.forEach(link => {
        const htmlLink = link as HTMLElement;
        htmlLink.addEventListener('mouseenter', () => updateIndicator(htmlLink));
        htmlLink.addEventListener('focusin', () => updateIndicator(htmlLink));
      });

      navList.addEventListener('mouseleave', () => {
        activeLink = null;
        navList.style.setProperty('--highlight-opacity', '0');
      });

      navList.addEventListener('focusout', (e: FocusEvent) => {
        if (!navList.contains(e.relatedTarget as Node | null)) {
          activeLink = null;
          navList.style.setProperty('--highlight-opacity', '0');
        }
      });

      let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        if (resizeTimeout) clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          if (activeLink) {
            updateIndicator(activeLink);
          }
        }, 100);
      });
    }
    // 2) & 3) My Classroom Text Morph and Click Animation
    const ctaBtn = document.querySelector(
      ".header-cta",
    ) as HTMLAnchorElement | null;
    if (ctaBtn) {
      const btnText = ctaBtn.querySelector(".btn-text");
      if (btnText && !btnText.querySelector(".header-cta-default")) {
        const defaultText = btnText.textContent?.trim() || "MY CLASSROOM";
        btnText.innerHTML = `
          <span class="header-cta-default">${defaultText}</span>
          <span class="header-cta-hover" aria-hidden="true">Go to Classroom &rarr;</span>
          <span class="header-cta-launching" aria-hidden="true">&check; Launching...</span>
        `;
      }

      ctaBtn.addEventListener("click", (e: MouseEvent) => {
        if (
          e.button !== 0 ||
          e.ctrlKey ||
          e.metaKey ||
          e.shiftKey ||
          e.altKey
        ) {
          return;
        }

        e.preventDefault();
        ctaBtn.classList.add("is-launching");
        const href = ctaBtn.getAttribute("href");
        const target = ctaBtn.getAttribute("target");

        setTimeout(() => {
          if (href) {
            if (target === "_blank") {
              window.open(href, "_blank");
              ctaBtn.classList.remove("is-launching");
            } else {
              window.location.href = href;
            }
          }
        }, 700);
      });

      window.addEventListener("pageshow", (event: PageTransitionEvent) => {
        if (event.persisted) {
          ctaBtn.classList.remove("is-launching");
        }
      });
    }
  });
</script>
