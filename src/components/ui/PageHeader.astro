---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="page-header text-center">
  <!-- Full-bleed responsive background artwork banner layer -->
  <div class="hero-bg-wrapper">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 1024px)"
        srcset="/images/hero/hero-desktop.png"
      />
      <source
        media="(min-width: 640px)"
        srcset="/images/hero/hero-tablet.png"
      />
      <img
        src="/images/hero/hero-mobile.png"
        alt="Venture Chess Academy Banner"
        class="hero-bg-img"
        width="841"
        height="1870"
        decoding="async"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
    <!-- Readability gradient overlay matching Hero.astro -->
    <div class="hero-overlay"></div>
  </div>

  <div class="container header-content relative z-10">
    {subtitle && <span class="subtitle reveal-fade-up" set:html={subtitle} />}
    <h1 class="title reveal-fade-up" set:html={title} />
    <slot />
  </div>
</div>

<style>
  .page-header {
    position: relative;
    min-height: 320px;
    height: 320px;
    padding-top: 80px;
    padding-bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #f9f9f8;
    border-bottom-left-radius: var(--radius-2xl);
    border-bottom-right-radius: var(--radius-2xl);
  }

  @media (min-width: 641px) {
    .page-header {
      min-height: 410px;
      height: 410px;
      padding-top: 90px;
    }
  }

  @media (min-width: 1024px) {
    .page-header {
      min-height: 520px;
      height: 520px;
      padding-top: 100px;
    }
  }

  /* Full-bleed background image container layer */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg-img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 65%;
  }

  @media (min-width: 641px) {
    .hero-bg-img {
      object-position: center center;
    }
  }

  @media (min-width: 1024px) {
    .hero-bg-img {
      object-position: right center;
    }
  }

  /* Soft vertical theme gradient overlay: lighter at top, darker toward bottom */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(89, 34, 24, 0.15) 0%,
      rgba(89, 34, 24, 0.28) 45%,
      rgba(89, 34, 24, 0.40) 100%
    );
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    margin: 0 auto;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-nav-bg, #FFF4E6);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.15;
    text-shadow:
      0 2px 12px rgba(89, 34, 24, 0.55),
      0 1px 3px rgba(89, 34, 24, 0.6);
    margin: 0 auto;
    max-width: 800px;
    text-align: center;
    width: 100%;
  }

  .subtitle {
    display: inline-block;
    color: var(--color-nav-bg);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    text-align: center;
  }

  .relative {
    position: relative;
  }

  .z-10 {
    z-index: 10;
  }
</style>
