---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="page-header text-center">
  <!-- Full-bleed responsive background artwork banner layer -->
  <div class="hero-bg-wrapper">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 1024px)"
        srcset="/images/hero/hero-desktop.png"
      />
      <source
        media="(min-width: 640px)"
        srcset="/images/hero/hero-tablet.png"
      />
      <img
        src="/images/hero/hero-mobile.png"
        alt="Venture Chess Academy Banner"
        class="hero-bg-img"
        width="841"
        height="1870"
        decoding="async"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
    <!-- Readability gradient overlay matching Hero.astro -->
    <div class="hero-overlay"></div>
  </div>

  <div class="container relative z-10">
    {subtitle && <span class="subtitle reveal-fade-up" set:html={subtitle} />}
    <h1 class="title reveal-fade-up" set:html={title} />
    <slot />
  </div>
</div>

<style>
  .page-header {
    position: relative;
    padding-top: 140px; /* Space for fixed navbar */
    padding-bottom: var(
      --space-xl
    ); /* Standardized bottom padding matching section spacing */
    overflow: hidden;
    background-color: #f9f9f8;
    border-bottom-left-radius: var(--radius-2xl);
    border-bottom-right-radius: var(--radius-2xl);
  }

  /* Full-bleed background image container layer */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg-img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center bottom;
  }

  @media (min-width: 640px) {
    .hero-bg-img {
      object-position: center center;
    }
  }

  @media (min-width: 1024px) {
    .hero-bg-img {
      object-position: right center;
    }
  }

  /* Readability gradient overlay matching Hero.astro */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  background: linear-gradient(to right, #3d3c3b59 0%, #42403e7a 45%, #6f6c694d 80%);
  }

  @media (max-width: 1023px) {
    .hero-overlay {
     background: linear-gradient(to right, #3d3c3b59 0%, #42403e7a 45%, #6f6c694d 80%);
    }
  }

  .title {
    color: var(--color-primary);
    font-size: var(--font-size-h1);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  .subtitle {
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  .text-center {
    text-align: center;
  }

  .relative {
    position: relative;
  }

  .z-10 {
    z-index: 10;
  }
</style>
