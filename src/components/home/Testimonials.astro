---
import { testimonials } from '../../data/testimonials';
---

<section class="section testimonials-section">
  <div class="container">
    <div class="section-header reveal-fade-up">
      <div class="header-content">
        <div class="title-group">
          <span class="subtitle">OUR TESTIMONIALS</span>
          <h2 class="title">What Students Say</h2>
        </div>
      </div>
    </div>

    <div class="carousel-container reveal-fade-up" style="transition-delay: 0.1s;">
      <div class="slider-wrapper">
        <button class="slider-btn prev-btn" aria-label="Previous testimonial" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        
        <div class="carousel-track" id="testimonialTrack">
        {testimonials.map((t) => (
          <div class="testimonial-card">
            <div class="quote-icon">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
            <div class="quote-text">{t.quote}</div>
            
            <div class="card-footer">
              <div class="author-avatar">
                {t.image ? (
                  <img src={t.image} alt={t.name} loading="lazy" />
                ) : (
                  <span class="avatar-initial">{t.name.charAt(0)}</span>
                )}
              </div>
              <div class="author-name">{t.name}</div>
            </div>
          </div>
        ))}
      </div>
      
        <button class="slider-btn next-btn" aria-label="Next testimonial">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background-color: var(--color-bg);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .carousel-container {
    /* Container wraps the track without breaking layout */
  }

  .slider-wrapper {
    position: relative;
    width: 100%;
  }

  .carousel-track {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 10px 5px; /* Prevent shadow clipping */
    margin: -10px -5px; /* Offset padding */
  }
  
  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .testimonial-card {
    /* 1 card on mobile */
    flex: 0 0 100%;
    scroll-snap-align: start;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-md) 32px; /* Extra side padding so overlapping arrows don't cover text */
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: auto; /* Stretch to fill track height */
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }

  @media (min-width: 768px) {
    .testimonial-card {
      /* 2 cards on tablet */
      flex: 0 0 calc(50% - (var(--space-md) / 2));
      padding: var(--space-lg); /* Restore large padding on tablet+ */
    }
  }

  @media (min-width: 1024px) {
    .testimonial-card {
      /* 3 cards on desktop */
      flex: 0 0 calc(33.3333% - (var(--space-md) * 2 / 3));
    }
  }

  .quote-icon {
    color: var(--color-secondary);
    width: 24px;
    height: 24px;
    margin-bottom: var(--space-md);
  }

  .quote-text {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .card-footer {
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #fce8d5; /* Soft peach fallback */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-initial {
    color: #4a3b2c; /* Dark brown */
    font-weight: 700;
    font-size: 1.1rem;
  }

  .author-name {
    font-weight: 700;
    color: #4a3b2c; /* Dark brown */
    font-size: 0.95rem;
    margin: 0;
  }

  /* Controls (Arrows) */
  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 38px; /* Size 36-40px */
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid var(--color-primary); /* Thin dark brown outline */
    color: var(--color-primary); /* Dark brown chevron */
    box-shadow: 0 2px 8px rgba(89, 34, 24, 0.15); /* Soft shadow */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out), background-color 0.2s var(--ease-out);
  }

  /* 44px minimum tap area */
  .slider-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 44px;
    min-height: 44px;
  }

  .slider-btn svg {
    width: 20px;
    height: 20px;
  }

  .slider-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .slider-btn:hover:not(:disabled) {
    background-color: var(--color-surface);
    transform: translateY(-50%) scale(1.05); /* Gentle hover */
  }

  .slider-btn:active:not(:disabled) {
    transform: translateY(-50%) scale(0.95); /* Press feel */
  }

  .slider-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Phone (overlap edges) */
  .prev-btn { left: -12px; }
  .next-btn { right: -12px; }

  @media (min-width: 641px) {
    /* Tablet: arrows outside if room, else edges. -16px pushes them a bit further out */
    .prev-btn { left: -16px; }
    .next-btn { right: -16px; }
  }

  @media (min-width: 1024px) {
    /* Desktop: arrows outside */
    .prev-btn { left: -48px; }
    .next-btn { right: -48px; }
  }

  @media (max-width: 767px) {
    .header-content {
      display: block;
    }
  }
</style>

<script>
  const initTestimonialSlider = () => {
    const track = document.getElementById('testimonialTrack');
    const prevBtn = document.querySelector('.testimonials-section .prev-btn') as HTMLButtonElement;
    const nextBtn = document.querySelector('.testimonials-section .next-btn') as HTMLButtonElement;
    if (!track) return;

    // Calculate width of one card + gap to slide exactly one item
    const getScrollAmount = () => {
      const card = track.querySelector('.testimonial-card');
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return card ? (card as HTMLElement).offsetWidth + gap : 0;
    };

    // Update disabled state for arrows when hitting the beginning/end
    const updateButtons = () => {
      if (!prevBtn || !nextBtn) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 5;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    };

    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    // Check button states after swiping completes
    track.addEventListener('scroll', () => {
      requestAnimationFrame(updateButtons);
    }, { passive: true });

    // Initial setup
    window.addEventListener('resize', updateButtons);
    updateButtons();
  };

  initTestimonialSlider();
</script>
