---
import { courses } from "../../data/courses";
---

<section class="section curriculum-section">
  <div class="container">
    <div class="section-header-row reveal-fade-up">
      <h2 class="title">Syllabus</h2>
    </div>

    <div class="curriculum-track-container reveal-fade-up" style="transition-delay: 0.2s;">
      <div class="slider-wrapper" style="position: relative; width: 100%;">
        <button class="course-slider-btn course-prev-btn" aria-label="Previous syllabus course" disabled style="position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>

        <div class="courses-grid" id="curriculumTrack" style="display: flex; flex-direction: row; flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
          {
            courses.map((course, index) => (
              <div class="course-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
                <div class="course-image">
                  <img src={course.image} alt={course.name} />
                </div>
                <div class="course-content">
                  <div class="course-level">LEVEL 0{index + 1}</div>
                  <h3 class="course-name">{course.name}</h3>
                  <p class="course-desc">{course.description}</p>
                  <a
                    href="/contact-us/"
                    class="course-link"
                  >
                    Join Now <span class="arrow">→</span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <button class="course-slider-btn course-next-btn" aria-label="Next syllabus course" style="position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="section-controls-row reveal-fade-up" style="transition-delay: 0.3s;">
      <a href="/chess-academy-karnataka-india/" class="btn-view-all">
        View All Courses <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    background-color: var(--color-bg);
  }

  /* Header Row */
  .section-header-row {
    margin-bottom: var(--space-lg);
  }

  .title {
    color: var(--color-primary);
    font-size: clamp(1.85rem, 4vw, 3rem);
    margin: 0;
  }

  /* Centered controls row below cards */
  .section-controls-row {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100%;
    margin-top: 36px; /* 32-40px gap between cards and button */
    margin-bottom: 56px; /* 48-64px space before Why Venture section */
    text-align: center;
  }

  .btn-view-all {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 16px;
    height: 40px;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background-color var(--duration-normal) var(--ease-out), transform var(--duration-normal) var(--ease-out);
    white-space: nowrap;
    margin: 0 auto;
  }

  /* Expand tap area to 44px */
  .btn-view-all::after {
    content: '';
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 0;
    right: 0;
  }

  .btn-view-all:hover {
    background-color: #3a1610; /* Darker brown */
    transform: translateY(-2px);
  }

  .btn-view-all .arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .btn-view-all:hover .arrow {
    transform: translateX(4px);
  }

  .slider-wrapper {
    position: relative;
    width: 100%;
  }

  /* Controls (Arrows) - exactly like amenities slider in Intro.astro */
  .course-slider-btn {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 10 !important;
    width: 38px !important;
    height: 38px !important;
    background-color: transparent !important;
    border: none !important;
    color: var(--color-primary) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out) !important;
  }

  .course-slider-btn::after {
    content: '' !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    min-width: 44px !important;
    min-height: 44px !important;
  }

  .course-slider-btn svg {
    width: 24px !important;
    height: 24px !important;
  }

  .course-slider-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 50%;
  }

  .course-slider-btn:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.15) !important;
  }

  .course-slider-btn:active:not(:disabled) {
    transform: translateY(-50%) scale(0.9) !important;
  }

  .course-slider-btn:disabled {
    opacity: 0.3 !important;
    cursor: not-allowed !important;
  }

  /* Hide arrows completely on desktop */
  @media (min-width: 1024px) {
    .course-slider-btn {
      display: none !important;
    }
  }

  /* Phone (overlap edges) */
  .course-prev-btn { left: -12px !important; }
  .course-next-btn { right: -12px !important; }

  @media (min-width: 641px) {
    .course-prev-btn { left: -16px !important; }
    .course-next-btn { right: -16px !important; }
  }

  /* Grid / Track Layout - Flex on mobile, Grid on desktop */
  .courses-grid {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: var(--space-md) !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    padding: 10px 5px !important;
    margin: -10px -5px !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch !important;
  }

  .courses-grid::-webkit-scrollbar {
    display: none !important;
  }

  /* Desktop Layout: Standard 3-column grid */
  @media (min-width: 1024px) {
    .courses-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      overflow-x: visible !important;
      padding: 0 !important;
      margin: 0 !important;
      scroll-snap-type: none !important;
    }
  }

  /* Card Layout */
  .course-card {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    scroll-snap-align: start !important;
    box-sizing: border-box !important;
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-sm);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
  }

  @media (min-width: 641px) {
    .course-card {
      flex: 0 0 calc(50% - (var(--space-md) / 2)) !important;
      width: calc(50% - (var(--space-md) / 2)) !important;
      min-width: calc(50% - (var(--space-md) / 2)) !important;
      max-width: calc(50% - (var(--space-md) / 2)) !important;
    }
  }

  @media (min-width: 1024px) {
    .course-card {
      flex: none !important;
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
    }
  }

  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  .course-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-md);
    background-color: var(--color-border);
  }

  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .course-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: 0 var(--space-xs);
  }

  /* Typography */
  .course-level {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #d4621c; /* Brand orange */
    margin-bottom: 0.5rem;
  }

  .course-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .course-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  /* Join Now Link */
  .course-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
    background-color: #f2b77a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: static; 
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  /* Make entire card clickable */
  .course-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .course-link .arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .course-card:hover .course-link,
  .course-link:hover {
    background-color: #e5a867; /* Deeper peach on hover */
    color: var(--color-primary);
    transform: translateY(-2px);
  }

  .course-card:hover .course-link .arrow,
  .course-link:hover .arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .course-slider-btn {
      transition: none !important;
    }
  }
</style>

<script>
  const initCurriculumSlider = () => {
    const track = document.getElementById('curriculumTrack');
    const prevBtn = document.querySelector('.curriculum-section .course-prev-btn') as HTMLButtonElement;
    const nextBtn = document.querySelector('.curriculum-section .course-next-btn') as HTMLButtonElement;
    if (!track) return;

    const getScrollAmount = () => {
      const card = track.querySelector('.course-card');
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return card ? (card as HTMLElement).offsetWidth + gap : 0;
    };

    const updateButtons = () => {
      if (!prevBtn || !nextBtn) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 5;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    };

    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', () => {
      requestAnimationFrame(updateButtons);
    }, { passive: true });

    window.addEventListener('resize', updateButtons);
    setTimeout(updateButtons, 100);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCurriculumSlider);
  } else {
    initCurriculumSlider();
  }
</script>
