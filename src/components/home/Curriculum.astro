---
import { courses } from "../../data/courses";
---

<section class="section curriculum-section">
  <div class="container">
    <div class="section-header-row reveal-fade-up">
      <h2 class="title">Syllabus</h2>
      <a href="/chess-academy-karnataka-india/" class="btn-view-all">
        View All Courses <span class="arrow">→</span>
      </a>
    </div>

    <div class="courses-grid">
      {
        courses.map((course, index) => (
          <div
            class="course-card reveal-fade-up"
            style={`transition-delay: ${(index % 3) * 0.1}s;`}
          >
            <div class="course-image">
              <img src={course.image} alt={course.name} />
            </div>
            <div class="course-content">
              <div class="course-level">LEVEL 0{index + 1}</div>
              <h3 class="course-name">{course.name}</h3>
              <p class="course-desc">{course.description}</p>
              <a
                href={`/chess-academy-karnataka-india/#${course.id}`}
                class="course-link"
              >
                Join Now <span class="arrow">→</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    background-color: var(--color-bg);
  }

  /* Header Row */
  .section-header-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px; /* Small gap between title and button on phone */
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 641px) {
    .section-header-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
    }
  }

  .title {
    color: var(--color-primary);
    font-size: clamp(1.85rem, 4vw, 3rem);
    margin: 0;
  }

  .btn-view-all {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 16px;
    height: 40px;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background-color var(--duration-normal) var(--ease-out), transform var(--duration-normal) var(--ease-out);
    white-space: nowrap;
    margin-left: auto; /* Aligns right if it wraps to the second row */
    align-self: flex-end; /* Ensures right-alignment in column layout */
  }

  @media (min-width: 641px) {
    .btn-view-all {
      align-self: auto;
    }
  }

  /* Expand tap area to 44px */
  .btn-view-all::after {
    content: '';
    position: absolute;
    top: -2px;
    bottom: -2px;
    left: 0;
    right: 0;
  }

  .btn-view-all:hover {
    background-color: #3a1610; /* Darker brown */
    transform: translateY(-2px);
  }

  .btn-view-all .arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .btn-view-all:hover .arrow {
    transform: translateX(4px);
  }

  /* Grid Layout */
  .courses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .courses-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card Layout */
  .course-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-sm);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
  }

  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
  }

  .course-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-md);
    background-color: var(--color-border);
  }

  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .course-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: 0 var(--space-xs);
  }

  /* Typography */
  .course-level {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #d4621c; /* Brand orange */
    margin-bottom: 0.5rem;
  }

  .course-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .course-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
    flex-grow: 1;
  }

  /* Join Now Link */
  .course-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-surface);
    background-color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: static; 
    transition: background-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  /* Make entire card clickable */
  .course-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .course-link .arrow {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .course-card:hover .course-link {
    background-color: #3a1610; /* Darker brown */
    color: var(--color-surface);
    transform: translateY(-2px);
  }

  .course-card:hover .course-link .arrow {
    transform: translateX(4px);
  }
</style>
