---
// AdditionalBenefits.astro
import MagneticButton from '../ui/MagneticButton.astro';
---

<section class="section benefits-section">
  <div class="container">
    <div class="section-header reveal-fade-up">
      <span class="subtitle">WE ALSO PROVIDE</span>
      <h2 class="title">In every chess position,<br/>there are opportunities</h2>
    </div>

    <div class="benefits-track-container reveal-fade-up" style="transition-delay: 0.2s;">
      <div class="slider-wrapper" style="position: relative; width: 100%;">
        <button class="benefit-slider-btn benefit-prev-btn" aria-label="Previous benefit" disabled style="position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>

        <div class="benefits-grid" id="benefitsTrack" style="display: flex; flex-direction: row; flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/02/school-boys-playing-chess-e1698161918720.jpg');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Flexible Weekly Schedule</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>

          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/02/selective-focus-of-wooden-chess-board-with-seniors-playing-chess-at-home-e1697916079176.jpg');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Weekly Tournaments</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>

          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/02/smart-boy-playing-chess-and-staring-at-the-chessboard-e1698161801842.jpg');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Weekly Puzzle Quest</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>

          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/02/game-of-chess-e1698161986705.jpg');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Custom Position Drills</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>

          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/01/one-to-one-class.webp');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Assignments</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>

          <div class="benefit-card" style="flex: 0 0 100%; min-width: 100%; max-width: 100%; scroll-snap-align: start; box-sizing: border-box;">
            <div class="benefit-bg" style="background-image: url('https://venturechessacademy.com/wp-content/uploads/2026/02/teenager-playing-chess.jpg');"></div>
            <div class="benefit-overlay"></div>
            <div class="benefit-content">
              <h3 class="benefit-title">Video Courses</h3>
              <a href="/contact-us/" class="benefit-link">Learn More</a>
            </div>
          </div>
        </div>

        <button class="benefit-slider-btn benefit-next-btn" aria-label="Next benefit" style="position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="benefits-cta-row reveal-fade-up" style="display: flex; justify-content: center; align-items: center; width: 100%; margin-top: 36px; text-align: center; transition-delay: 0.25s;">
      <MagneticButton href="/contact-us/" text="Talk to a Coach" variant="primary" className="benefits-cta-btn" />
    </div>
  </div>
</section>

<style>
  .benefits-section {
    background-color: var(--color-surface);
  }

  .slider-wrapper {
    position: relative;
    width: 100%;
  }

  /* Controls (Arrows) - exactly like amenities slider in Intro.astro */
  .benefit-slider-btn {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 10 !important;
    width: 38px !important;
    height: 38px !important;
    background-color: transparent !important;
    border: none !important;
    color: var(--color-primary) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out) !important;
  }

  .benefit-slider-btn::after {
    content: '' !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    min-width: 44px !important;
    min-height: 44px !important;
  }

  .benefit-slider-btn svg {
    width: 24px !important;
    height: 24px !important;
  }

  .benefit-slider-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 50%;
  }

  .benefit-slider-btn:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.15) !important;
  }

  .benefit-slider-btn:active:not(:disabled) {
    transform: translateY(-50%) scale(0.9) !important;
  }

  .benefit-slider-btn:disabled {
    opacity: 0.3 !important;
    cursor: not-allowed !important;
  }

  /* Hide arrows completely on desktop */
  @media (min-width: 1024px) {
    .benefit-slider-btn {
      display: none !important;
    }
  }

  /* Phone (overlap edges) */
  .benefit-prev-btn { left: -12px !important; }
  .benefit-next-btn { right: -12px !important; }

  @media (min-width: 641px) {
    .benefit-prev-btn { left: -16px !important; }
    .benefit-next-btn { right: -16px !important; }
  }

  /* Grid / Track Layout - Flex on mobile, Grid on desktop */
  .benefits-grid {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: var(--space-md) !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    padding: 10px 5px !important;
    margin: -10px -5px !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch !important;
  }

  .benefits-grid::-webkit-scrollbar {
    display: none !important;
  }

  /* Desktop Layout: Standard 3-column grid */
  @media (min-width: 1024px) {
    .benefits-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      overflow-x: visible !important;
      padding: 0 !important;
      margin: 0 !important;
      scroll-snap-type: none !important;
    }
  }

  .benefit-card {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    scroll-snap-align: start !important;
    box-sizing: border-box !important;
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    height: 350px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem 1.5rem;
    cursor: pointer;
  }

  @media (min-width: 641px) {
    .benefit-card {
      flex: 0 0 calc(50% - (var(--space-md) / 2)) !important;
      width: calc(50% - (var(--space-md) / 2)) !important;
      min-width: calc(50% - (var(--space-md) / 2)) !important;
      max-width: calc(50% - (var(--space-md) / 2)) !important;
      padding: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .benefit-card {
      flex: none !important;
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
    }
  }

  .benefit-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s var(--ease-out);
    z-index: 1;
  }

  .benefit-card:hover .benefit-bg {
    transform: scale(1.1);
  }

  .benefit-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0) 100%);
    z-index: 2;
    transition: background 0.4s var(--ease-out);
  }

  .benefit-card:hover .benefit-overlay {
    background: linear-gradient(to top, rgba(89, 34, 24, 0.9) 0%, rgba(89, 34, 24, 0.4) 50%, rgba(0,0,0,0) 100%);
  }

  .benefit-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .benefit-title {
    color: #ffffff;
    font-size: 1.75rem;
    line-height: 1.2;
    margin-bottom: var(--space-md);
    font-weight: 700;
  }

  .benefit-link {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-btn-peach, #f2b77a);
    color: var(--color-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s var(--ease-out);
  }

  .benefit-card:hover .benefit-link {
    opacity: 1;
    transform: translateY(0);
  }

  .benefit-link:hover {
    background-color: #ffffff;
    transform: translateY(-2px);
  }

  /* Centered CTA row below benefits grid */
  .benefits-cta-row {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    margin: 36px auto 0 auto !important;
    text-align: center !important;
  }

  .benefits-cta-row :global(.magnetic-btn) {
    margin: 0 auto !important;
    border-radius: 8px !important;
    height: 44px !important;
    min-height: 44px !important;
    padding: 0 24px !important;
    white-space: nowrap !important;
    color: var(--color-surface) !important;
    background-color: var(--color-primary) !important;
  }

  .benefits-cta-row :global(.magnetic-btn .btn-bg) {
    border-radius: 8px !important;
    background-color: var(--color-primary) !important;
    transition: background-color var(--duration-normal) var(--ease-out), transform 0.4s var(--ease-spring) !important;
  }

  .benefits-cta-row :global(.magnetic-btn:hover .btn-bg) {
    background-color: #3a1610 !important;
  }

  .benefits-cta-row :global(.magnetic-btn .btn-text) {
    color: var(--color-surface) !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    white-space: nowrap !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .benefits-cta-row :global(.magnetic-btn:hover .btn-text) {
    color: var(--color-surface) !important;
  }

  @media (max-width: 640px) {
    .benefits-cta-row {
      margin-top: 28px !important;
    }

    .benefits-cta-row :global(.magnetic-btn) {
      height: 44px !important;
      padding: 0 20px !important;
      margin: 0 auto !important;
    }

    .benefits-cta-row :global(.btn-text) {
      font-size: 13px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-slider-btn {
      transition: none !important;
    }
  }
</style>

<script>
  const initBenefitsSlider = () => {
    const track = document.getElementById('benefitsTrack');
    const prevBtn = document.querySelector('.benefits-section .benefit-prev-btn') as HTMLButtonElement;
    const nextBtn = document.querySelector('.benefits-section .benefit-next-btn') as HTMLButtonElement;
    if (!track) return;

    const getScrollAmount = () => {
      const card = track.querySelector('.benefit-card');
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return card ? (card as HTMLElement).offsetWidth + gap : 0;
    };

    const updateButtons = () => {
      if (!prevBtn || !nextBtn) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      prevBtn.disabled = track.scrollLeft <= 5;
      nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    };

    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', () => {
      requestAnimationFrame(updateButtons);
    }, { passive: true });

    window.addEventListener('resize', updateButtons);
    setTimeout(updateButtons, 100);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBenefitsSlider);
  } else {
    initBenefitsSlider();
  }
</script>
